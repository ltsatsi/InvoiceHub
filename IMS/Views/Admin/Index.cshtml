@model IMS.ViewModels.DashboardViewModel

@{
    ViewData["Title"] = "Dashboard";
}

<div class="container py-4">

    <div class="row g-3 mb-4">

        <div class="col-md-4">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h6>Users</h6>
                    <h3>@Model.AppUserCount</h3>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h6>Clients</h6>
                    <h3>@Model.ClientCount</h3>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h6>Invoices</h6>
                    <h3>@Model.InvoiceCount</h3>
                </div>
            </div>
        </div>

    </div>

    <div class="row g-4">

        <div class="col-12">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <h5>System Users</h5>
                    <p class="text-muted">
                        Overview of all registered users currently using the platform.
                    </p>
                </div>
                <a asp-action="" asp-controller="Admin">See All</a>
            </div>

                    @if (Model.Users.Any())
                    {
                        <div class="table-responsive mt-2">
                            <table class="table table-hover table-bordered align-middle">
                                <thead class="bg-light">
                                    <tr>
                                        <th>Name</th>
                                        <th>Email</th>
                                        <th>Address Line</th>
                                        <th></th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var user in Model.Users.Take(5))
                                    {
                                        <tr>
                                            <td>@user.FullName</td>
                                            <td>
                                                <a href="mailto:@user.Email">@user.Email</a>
                                            </td>
                                    <td>@user.AddressLine</td>
                                    <td class="d-flex justify-content-evenly align-items-center">
                                        <a asp-action="Update" asp-controller="Admin" asp-route-id="@user.Id"><i class="bi bi-pencil text-dark me-2"></i></a>
                                        <a asp-action="Delete" asp-controller="Admin" asp-route-id="@user.Id"><i class="bi bi-trash text-danger"></i></a>
                                    </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <p class="text-muted mb-0">No users found.</p>
                    }

        </div>

        <hr />

        <div class="row g-3 mb-2">
            <div class="col-12">
                <div class="card shadow-sm">
                    <div class="card-body">
                        <h6>Revenue</h6>
                        <h3>R @Model.TotalRevenue.ToString("N2")</h3>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-6">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <h5>System Clients</h5>
                    <p class="text-muted">
                        Clients created by users for invoice and billing management.
                    </p>
                </div>
                <a asp-action="" asp-controller="Admin">See All</a>
            </div>

                    @if (Model.Clients.Any())
                    {
                        <div class="table-responsive mt-2">
                    <table class="table table-hover table-bordered align-middle">
                                <thead>
                                    <tr>
                                        <th>Name</th>
                                        <th>Email</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var client in Model.Clients.Take(5))
                                    {
                                        <tr>
                                            <td>@client.FullName</td>
                                            <td>
                                        <a href="mailto:@client.Email">@client.Email</a>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <p class="text-muted mb-0">No clients found.</p>
                    }

        </div>

        <div class="col-lg-6">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <h5>Recent Invoices</h5>
                    <p class="text-muted">
                        Recently issued invoices and their associated revenue.
                    </p>
                </div>
                <a asp-action="" asp-controller="Admin">See All</a>
            </div>

                    @if (Model.Invoices.Any())
                    {
                        <div class="table-responsive mt-2">
                    <table class="table table-hover table-bordered align-middle">
                                <thead>
                                    <tr>
                                        <th>Invoice No</th>
                                        <th>Total</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var invoice in Model.Invoices.Take(5))
                                    {
                                        <tr>
                                            <td>@invoice.InvoiceNumber</td>
                                            <td>R @invoice.GrandTotal.ToString("N2")</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <p class="text-muted mb-0">No invoices found.</p>
                    }

        </div>

    </div>

</div>