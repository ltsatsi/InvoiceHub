@model IMS_DomainLayer.Dtos.Invoice.InvoiceDto

@{
    ViewData["Title"] = "Update";
}


<div class="d-flex align-items-center gap-4 my-4">
    <div class="border rounded py-1 px-2">
        <a href="javascript:history.back()" class="text-dark"><i class="bi bi-chevron-left fs-5"></i></a>
    </div>
    <h4 class="p-0 m-0">Update Invoice</h4>
</div>


<div class="row">
    <div class="col col-md-8">
        <form asp-action="Update">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <input hidden asp-for="Id" class="form-control" />
            </div>
            <div class="form-group">
                <input hidden asp-for="ClientId" class="form-control" />
            </div>
            <div class="form-group">
                <label asp-for="InvoiceNumber" class="control-label mb-1"></label>
                <input readonly asp-for="InvoiceNumber" class="form-control bg-white text-muted" />
                <span asp-validation-for="InvoiceNumber" class="text-danger"></span>
            </div>

            <div class="row mt-3">
                <div class="col-6 form-group">
                    <label asp-for="DateIssued" class="control-label mb-1"></label>
                    <input asp-for="DateIssued" class="form-control" />
                    <span asp-validation-for="DateIssued" class="text-danger"></span>
                </div>
                <div class="col-6 form-group">
                    <label asp-for="DueDate" class="control-label mb-1"></label>
                    <input asp-for="DueDate" class="form-control" />
                    <span asp-validation-for="DueDate" class="text-danger"></span>
                </div>
            </div>

            <div id="invoiceItemsContainer" class="mt-3">

                @{
                    var items = Model.InvoiceItems.ToList();
                }

                @for (int i = 0; i < items.Count; i++)
                {
                    <div class="card mb-3 invoice-item">

                        <div class="card-body">

                            <div class="d-flex justify-content-between align-items-center mb-3">

                                <h6>Item @(i + 1)</h6>

                                <button type="button"
                                        class="btn btn-sm btn-outline-danger remove-item">
                                    <i class="bi bi-trash"></i>
                                </button>

                            </div>

                            <input type="hidden"
                                   name="InvoiceItems[@i].Id"
                                   value="@items[i].Id" />

                            <div class="mb-3">
                                <label class="form-label">Name</label>

                                <input class="form-control"
                                       name="InvoiceItems[@i].Name"
                                       value="@items[i].Name" />
                            </div>

                            <div class="row">

                                <div class="col-md-4">
                                    <label class="form-label">Quantity</label>

                                    <input type="number"
                                           class="form-control"
                                           name="InvoiceItems[@i].Quantity"
                                           value="@items[i].Quantity" />
                                </div>

                                <div class="col-md-4">
                                    <label class="form-label">Tax</label>

                                    <input type="number"
                                           step="0.01"
                                           readonly
                                           class="form-control"
                                           name="InvoiceItems[@i].Tax"
                                           value="@items[i].Tax" />
                                </div>

                                <div class="col-md-4">
                                    <label class="form-label">Amount</label>

                                    <input type="number"
                                           step="0.01"
                                           class="form-control"
                                           name="InvoiceItems[@i].Amount"
                                           value="@items[i].Amount" />
                                </div>

                            </div>

                        </div>

                    </div>
                }

            </div>

            <button type="button"
                    id="addItemBtn"
                    class="btn btn-default border w-100">
                Add Item
            </button>

            <div class="form-group mt-3">
                <input hidden asp-for="Subtotal" class="form-control" />
            </div>
            <div class="form-group mt-3">
                <label asp-for="Discount" class="control-label mb-1"></label>
                <input asp-for="Discount" class="form-control" />
                <small class="text-muted">Provide discount as a percentage from 0 to 1</small>
                <span asp-validation-for="Discount" class="text-danger"></span>
            </div>
            <div class="form-group mt-3">
                <input hidden asp-for="GrandTotal" class="form-control" />
            </div>
            <div class="form-group mt-4">
                <input type="submit" value="Save" class="btn btn-primary w-100" />
            </div>
        </form>
    </div>
</div>

<script>

    let index = @Model.InvoiceItems.Count;

    const container =
        document.getElementById("invoiceItemsContainer");

    document.getElementById("addItemBtn")
        .addEventListener("click", addItem);

    function addItem() {

        const html = `
            <div class="card mb-3 invoice-item">

                <div class="card-body">

                    <div class="d-flex justify-content-between align-items-center mb-3">

                        <h6>Item ${index + 1}</h6>

                        <button type="button"
                                class="btn btn-sm btn-outline-danger remove-item">
                            <i class="bi bi-trash"></i>
                        </button>

                    </div>

                    <input type="hidden"
                           name="InvoiceItems[${index}].Id"
                           value="0" />

                    <div class="mb-3">
                        <label class="form-label">Name</label>

                        <input class="form-control"
                               placeholder="Enter name"
                               name="InvoiceItems[${index}].Name" />
                    </div>

                    <div class="row">

                        <div class="col-md-4">
                            <label class="form-label">Quantity</label>

                            <input type="number"
                                   min="1"
                                   class="form-control"
                                   name="InvoiceItems[${index}].Quantity" />
                        </div>

                        <div class="col-md-4">
                            <label class="form-label">Tax</label>

                            <input type="number"
                                   step="0.01"
                                   readonly
                                   value="15"
                                   class="form-control"
                                   name="InvoiceItems[${index}].Tax" />
                        </div>

                        <div class="col-md-4">
                            <label class="form-label">Amount</label>

                            <input type="number"
                                   step="0.01"
                                   class="form-control"
                                   name="InvoiceItems[${index}].Amount" />
                        </div>

                    </div>

                </div>

            </div>
        `;

        container.insertAdjacentHTML("beforeend", html);

        index++;
    }

    container.addEventListener("click", function (e) {

        if (e.target.classList.contains("remove-item")) {

            e.target.closest(".invoice-item").remove();

            reindexItems();
        }

    });

    function reindexItems() {

        const cards =
            document.querySelectorAll(".invoice-item");

        cards.forEach((card, i) => {

            card.querySelector("h6").textContent =
                `Item ${i + 1}`;

            card.querySelector('[name$=".Id"]')
                .name = `InvoiceItems[${i}].Id`;

            card.querySelector('[name$=".Name"]')
                .name = `InvoiceItems[${i}].Name`;

            card.querySelector('[name$=".Quantity"]')
                .name = `InvoiceItems[${i}].Quantity`;

            card.querySelector('[name$=".Tax"]')
                .name = `InvoiceItems[${i}].Tax`;

            card.querySelector('[name$=".Amount"]')
                .name = `InvoiceItems[${i}].Amount`;
        });

        index = cards.length;
    }

</script>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
