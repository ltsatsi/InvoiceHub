@model IMS_DomainLayer.Dtos.Invoice.InvoiceDto

@{
    ViewData["Title"] = "Create";
}


<div class="d-flex align-items-center gap-4 my-4">
    <div class="border rounded py-1 px-2">
        <a asp-action="Index" class="text-dark"><i class="bi bi-chevron-left fs-5"></i></a>
    </div>
    <h4 class="p-0 m-0">Create Invoice</h4>
</div>


<div class="row">
    <div class="col col-md-8">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <input hidden asp-for="ClientId" class="form-control" />
            </div>


            <h5>Invoice Information</h5>

            <div class="form-group mt-3">
                <label asp-for="InvoiceNumber" class="control-label mb-1"></label>
                <input readonly asp-for="InvoiceNumber" class="form-control text-muted bg-white" />
                <span asp-validation-for="InvoiceNumber" class="text-danger"></span>
            </div>
            <div class="row mt-3">
                <div class="col-6 form-group">
                    <label asp-for="DateIssued" class="control-label mb-1"></label>
                    <input asp-for="DateIssued" class="form-control" />
                    <span asp-validation-for="DateIssued" class="text-danger"></span>
                </div>
                <div class="col-6 form-group">
                    <label asp-for="DueDate" class="control-label mb-1"></label>
                    <input asp-for="DueDate" class="form-control" />
                    <span asp-validation-for="DueDate" class="text-danger"></span>
                </div>
            </div>

            <h5 class="mt-4">Invoice Items</h5>

            <div class="mt-3" id="invoiceItemsContainer">
            </div>

            <button type="button"
                    class="btn btn-default border w-100 mb-3"
                    id="addItemBtn">
                Add Item
            </button>

            <template id="invoiceItemTemplate">

                <div class="card mb-3 invoice-item">
                    <div class="card-body">

                        <div class="d-flex justify-content-between mb-3">
                            <h6 class="item-number"></h6>

                            <button type="button"
                                    class="btn btn-sm btn-outline-danger remove-item">
                                <i class="bi bi-trash"></i>
                            </button>
                        </div>

                        <div class="mb-3">
                            <label>Name</label>

                            <input class="form-control item-name" placeholder="Enter name">
                        </div>

                        <div class="row">

                            <div class="col-4">
                                <label>Qty</label>

                                <input type="number"
                                       min="1"
                                       class="form-control quantity">
                            </div>

                            <div class="col-4">
                                <label>Tax</label>

                                <input type="number"
                                       readonly
                                       value="15"
                                       class="form-control tax bg-white text-muted">
                            </div>

                            <div class="col-4">
                                <label>Amount</label>

                                <input type="number"
                                       step="0.01"
                                       class="form-control amount">
                            </div>

                        </div>

                    </div>
                </div>

            </template>


            <div class="form-group">
                <label asp-for="Discount" class="control-label mb-1"></label>
                <input asp-for="Discount" class="form-control" value="" placeholder="e.g. 0.45" />
                <small class="text-muted">Provide discount as a percentage from 0 to 1</small>
                <span asp-validation-for="Discount" class="text-danger"></span>
            </div>

            <div class="form-group mt-3">
                <input type="submit" value="Create Invoice" class="btn btn-primary mt-3 w-100" />
            </div>
        </form>
    </div>
</div>

<script>
    const container =
        document.getElementById("invoiceItemsContainer");

    const template =
        document.getElementById("invoiceItemTemplate");

    const addItemBtn =
        document.getElementById("addItemBtn");

    let index = 0;

    addItemBtn.addEventListener("click", addItem);

    function addItem() {

        const clone =
            template.content.cloneNode(true);

        clone.querySelector(".item-number")
            .textContent = `Item ${index + 1}`;

        clone.querySelector(".item-name")
            .name = `InvoiceItems[${index}].Name`;

        clone.querySelector(".quantity")
            .name = `InvoiceItems[${index}].Quantity`;

        clone.querySelector(".tax")
            .name = `InvoiceItems[${index}].Tax`;

        clone.querySelector(".amount")
            .name = `InvoiceItems[${index}].Amount`;

        container.appendChild(clone);

        index++;
    }

    container.addEventListener("click", function(e) {

        if (e.target.closest(".remove-item")) {

            e.target
                .closest(".invoice-item")
                .remove();

            renumberItems();
        }

    });

    function renumberItems() {

        const items =
            document.querySelectorAll(".invoice-item");

        items.forEach((item, i) => {

            item.querySelector(".item-number")
                .textContent = `Item ${i + 1}`;

            item.querySelector(".item-name")
                .name = `InvoiceItems[${i}].ItemName`;

            item.querySelector(".quantity")
                .name = `InvoiceItems[${i}].Quantity`;

            item.querySelector(".tax")
                .name = `InvoiceItems[${i}].Tax`;

            item.querySelector(".amount")
                .name = `InvoiceItems[${i}].Amount`;
        });

        index = items.length;
    }
</script>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
