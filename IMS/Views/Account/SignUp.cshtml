@model IMS_DomainLayer.Dtos.Account.SignUpDto

@{
    ViewData["Title"] = "Sign Up";
}


<div class="row justify-content-center align-items-center" style="min-height: 80vh;">
    <div class="col col-md-4 p-5">

        <div class="mb-5 text-center">
            <h2 class="auth-title">Create Account</h2>
            <p class="text-muted">
                Let's get started with your 30 days free trial
            </p>
        </div>

        <div>
                <form asp-action="SignUp">
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                    <div class="form-group mt-3">
                        <label asp-for="FullName" class="control-label mb-1"></label>
                        <input asp-for="FullName" class="form-control" placeholder="Enter full name" />
                        <span asp-validation-for="FullName" class="text-danger"></span>
                    </div>
                    <div class="form-group mt-3">
                        <label asp-for="Email" class="control-label mb-1"></label>
                        <input asp-for="Email" class="form-control" placeholder="Enter email" />
                        <span asp-validation-for="Email" class="text-danger"></span>
                    </div>
                    <div class="form-group mt-3">
                        <label asp-for="AddressLine" class="control-label mb-1"></label>
                        <input asp-for="AddressLine" class="form-control" placeholder="Enter address" />
                        <small class="form-text text-muted">e.g. 123 Yellow, Yellow Street</small> <br />
                        <span asp-validation-for="AddressLine" class="text-danger"></span>
                    </div>

                    <div class="row">

                        <div class="col-6 form-group mt-3">
                            <label asp-for="Password" class="control-label mb-1"></label>
                            <input asp-for="Password" class="form-control" placeholder="Enter password" />
                            <span asp-validation-for="Password" class="text-danger"></span>
                        </div>
                        <div class="col-6 form-group mt-3">
                            <label asp-for="ConfirmPassword" class="control-label mb-1"></label>
                            <input asp-for="ConfirmPassword" class="form-control" placeholder="Confirm password" />
                            <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="form-group mt-4">
                        <input type="submit" value="Create Account" class="btn btn-primary" style="width:100%;" />
                    </div>

                    <div class="form-group mt-4">
                        <p class="text-center">Have an account ? <a asp-area="" asp-controller="Account" asp-action="SignIn">Sign In</a></p>
                    </div>
                </form>
        </div>
    </div>
</div>



@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
